# Copy to .env and fill in. Every value is read by app/config.py.

# --- core services ---------------------------------------------------------
DOZ_DATABASE_URL=postgresql+psycopg://doz:doz@localhost:5432/doz
DOZ_REDIS_URL=redis://localhost:6379/0

# --- auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This key also derives the per-MAC boot-script signature, so rotating it
# invalidates in-flight provisioning jobs. Rotate between installs, not during.
DOZ_JWT_SECRET=change-me-before-anything-touches-the-internet
DOZ_ACCESS_TOKEN_TTL_SECONDS=28800

# --- control plane addressing ----------------------------------------------
# Where the installer ramdisk and iPXE reach the API. Must be resolvable from
# the provisioning VLAN. Not the same address customers use.
DOZ_CONTROL_PLANE_URL=http://10.10.0.5:8000
# Where kernels, initrds and ISOs are served from. Plain HTTP: CIMC vMedia
# will not follow redirects and cannot validate an unknown CA.
DOZ_BOOT_ASSET_BASE_URL=http://10.10.0.5:8080

# --- secrets ---------------------------------------------------------------
# env | file | vault. Use vault in production.
DOZ_SECRETS_BACKEND=env
# The env backend falls back to these for the whole fleet, which is fine on
# the bench and not fine in a rack.
DOZ_CIMC_DEFAULT_USER=admin
DOZ_CIMC_DEFAULT_PASS=change-me
# Per-server override, keyed off the credential ref (cimc/FCH1234 ->
# DOZ_CIMC_CIMC_FCH1234_USER / _PASS).

# For the file backend:
# DOZ_SECRETS_FILE_DIR=/run/secrets/cimc

# For the vault backend:
# DOZ_VAULT_ADDR=https://vault.internal:8200
# DOZ_VAULT_TOKEN=
# DOZ_VAULT_MOUNT=secret

# --- BMC transport ---------------------------------------------------------
# The M4's certificate can never be replaced -- Cisco will not ship another
# CIMC build. The isolated OOB VLAN is what provides the boundary here.
DOZ_REDFISH_VERIFY_TLS=false
DOZ_REDFISH_TIMEOUT_SECONDS=30
DOZ_REDFISH_MAX_RETRIES=3
# auto | ipmi | redfish. auto = IPMI first, Redfish if IPMI fails. Each server
# can override this in the admin panel.
DOZ_BMC_PROTOCOL=auto
# Pin cipher suite 3. Leaving it empty makes ipmitool probe for a suite, which
# costs ten seconds per call on BMCs that ignore the probe.
DOZ_IPMI_CIPHER_SUITE=3
DOZ_IPMI_PORT=623
DOZ_IPMI_TIMEOUT_SECONDS=20
# Only for servers set to UEFI boot. The guide sets the M4s to legacy.
DOZ_IPMI_BOOT_EFI=false
# Live power-state reads for the panel: short timeout, brief cache.
DOZ_BMC_STATUS_TIMEOUT_SECONDS=10
DOZ_BMC_STATUS_CACHE_SECONDS=10
# How long a graceful shutdown may take before the job says "use Force off".
DOZ_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=300
# What Prepare BMC sets as the persistent boot order: disk,pxe (default:
# boot the OS, installs use a one-time PXE override), pxe,disk (every boot
# asks the management server first), or empty to leave it alone.
DOZ_BMC_PREPARE_BOOT_ORDER=disk,pxe
# NTP servers Prepare BMC points each CIMC at, so event-log times are real.
# Empty leaves the CIMC clock alone.
DOZ_NTP_SERVERS=
# Live sensor / event-log / BMC-info reads for the panel are cached this long,
# so several open tabs share one IPMI session.
DOZ_BMC_LIVE_CACHE_SECONDS=3

# --- images ----------------------------------------------------------------
# Where uploaded ISO images live. Empty = installer/assets/iso, which is served
# at DOZ_BOOT_ASSET_BASE_URL/iso/ -- the URL a BMC fetches virtual media from.
DOZ_IMAGE_DIR=

# --- provisioning ----------------------------------------------------------
DOZ_INSTALL_TIMEOUT_SECONDS=2700
DOZ_CALLBACK_TOKEN_TTL_SECONDS=14400
# Refuse to return a server to sellable stock unless a wipe actually erased
# something. Leave this on.
DOZ_REQUIRE_WIPE_BEFORE_STOCK=true
# Pin each job's boot files to the first address that fetches them. Needs a
# DHCP server that keys leases on MAC only (dnsmasq: dhcp-ignore-clid). Set
# false if you are relying on a router's DHCP you do not control.
DOZ_BOOT_PIN_CLIENT_IP=true
# Set true only when nginx (or another proxy you run) is in front of the API.
DOZ_TRUST_PROXY_HEADERS=false

# --- console ---------------------------------------------------------------
DOZ_IPMITOOL_PATH=ipmitool
# A serial console with no traffic either way for this long is closed, which
# frees the BMC's single SOL slot. The max is a hard cap regardless.
DOZ_SOL_IDLE_TIMEOUT_SECONDS=1800
DOZ_SOL_MAX_SESSION_SECONDS=28800
DOZ_CONSOLE_TICKET_TTL_SECONDS=60
# vKVM launch URL. Empty = probe the CIMC for its HTML5 viewer, then fall back
# to the Java launcher. Placeholders: {host} {tkn1} {tkn2}. Example:
# DOZ_KVM_URL_TEMPLATE='https://{host}/html/kvmViewer.html?tkn1={tkn1}&tkn2={tkn2}'
DOZ_KVM_URL_TEMPLATE=

# --- misc ------------------------------------------------------------------
DOZ_CORS_ORIGINS=http://localhost:5173
DOZ_LOG_LEVEL=INFO
DOZ_ENVIRONMENT=development
